@page "/printers"
@using MediPro.Core.Models
@inject HttpClient Http

<PageTitle>Printers - VMS MediPro</PageTitle>

<div class="dashboard-header mb-4">
    <h2 class="section-title">Printer Fleet Management</h2>
    <p class="text-muted">Status and configuration of all registered printers in the routing engine.</p>
</div>

@if (printers == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var p in printers)
        {
            <div class="col">
                <div class="glass-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title text-accent mb-0">
                                <span class="oi oi-print me-2" aria-hidden="true"></span>
                                @p.Name
                            </h5>
                            @if (p.Status == PrinterStatusCode.Idle)
                            {
                                <span class="badge bg-success px-3 py-2">Ready</span>
                            }
                            else if (p.Status == PrinterStatusCode.Printing || p.Status == PrinterStatusCode.Processing)
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">Printing</span>
                            }
                            else if (p.Status == PrinterStatusCode.Offline)
                            {
                                <span class="badge bg-danger px-3 py-2">Offline</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">@p.Status.ToString()</span>
                            }
                        </div>
                        
                        <div class="printer-details text-muted mt-3">
                            <div class="d-flex justify-content-between border-bottom border-secondary pb-2 mb-2">
                                <span><span class="oi oi-file me-2"></span> Paper Size</span>
                                <span class="text-light">@p.PaperSize</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary pb-2 mb-2">
                                <span><span class="oi oi-layers me-2"></span> Type</span>
                                <span class="text-light">@(p.IsDryFilmPrinter ? "PET Medical Film" : "Standard Inkjet")</span>
                            </div>
                            <div class="d-flex justify-content-between pb-2">
                                <span><span class="oi oi-sort-ascending me-2"></span> Priority</span>
                                <span class="text-light">@(p.IsDryFilmPrinter ? 3 : 1)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private PrinterInfo[]? printers;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            printers = await Http.GetFromJsonAsync<PrinterInfo[]>("api/dashboard/printers");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching printers: {ex.Message}");
        }
    }
}
