@page "/logs"
@using MediPro.Core.Models
@inject HttpClient Http

<PageTitle>PNDT Compliance Logs - VMS MediPro</PageTitle>

<div class="dashboard-header mb-4">
    <h2 class="section-title">PNDT Compliance Audit Trail</h2>
    <p class="text-muted">Legally required audit trail for all obstetric ultrasound prints.</p>
</div>

@if (logs == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (logs.Length == 0)
{
    <div class="alert alert-info bg-dark text-light border-secondary">
        <span class="oi oi-info me-2"></span> No PNDT logs recorded yet.
    </div>
}
else
{
    <div class="glass-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-borderless table-hover mb-0">
                    <thead class="bg-darker">
                        <tr>
                            <th class="ps-4">Timestamp</th>
                            <th>Patient Name</th>
                            <th>ID</th>
                            <th>Modality</th>
                            <th>Images</th>
                            <th>Form F</th>
                            <th class="pe-4">Integrity Hash</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@log.TimestampUtc.ToLocalTime().ToString("g")</td>
                                <td class="fw-bold">@log.PatientName</td>
                                <td><span class="text-secondary font-monospace">@log.PatientId</span></td>
                                <td><span class="badge bg-primary">@log.Modality</span></td>
                                <td>@log.ImageCount</td>
                                <td>
                                    @if (log.FormFGenerated)
                                    {
                                        <span class="badge bg-success"><span class="oi oi-check"></span> Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><span class="oi oi-warning"></span> Pending</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <div class="text-truncate text-secondary font-monospace" style="max-width: 150px;" title="@log.IntegrityHash">
                                        @(string.IsNullOrEmpty(log.IntegrityHash) ? "N/A" : log.IntegrityHash)
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private PndtLogEntry[]? logs;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            logs = await Http.GetFromJsonAsync<PndtLogEntry[]>("api/dashboard/logs");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching PNDT logs: {ex.Message}");
        }
    }
}
